---
import ItemPage from '../../components/ItemPage.astro';
import { services } from '../../data/site';

export function getStaticPaths() {
  return services.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
---
<ItemPage
  item={item}
  section={{ label: 'Services', href: '/services/' }}
  pointsHeading="What this covers"
  related={{ heading: 'Other services', base: '/services/', items: services.filter((s) => s.slug !== item.slug) }}
/>
