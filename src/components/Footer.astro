---
import { company, services, industries, solutions } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Services', links: services.map((s) => ({ label: s.title, href: `/services/${s.slug}/` })) },
  { title: 'Industries', links: industries.map((s) => ({ label: s.title, href: `/industries/${s.slug}/` })) },
  { title: 'Solutions', links: solutions.map((s) => ({ label: s.title, href: `/solutions/${s.slug}/` })) },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Insights', href: '/insights/' },
      { label: 'Careers', href: '/careers/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="id">
        <img src="/brand/logo-white.svg" alt="StarmanSat" width="178" height="30" />
        <address>
          {company.address.street}<br />
          {company.address.city}, {company.address.region} {company.address.postal}
        </address>
        <a href={`mailto:${company.email}`}>{company.email}</a>
        {company.linkedin && <a href={company.linkedin} rel="noopener">LinkedIn</a>}
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="legal">
      <p>© {year} {company.legalName}</p>
      <a href="/privacy-policy/">Privacy policy</a>
      <a href="/terms/">Terms of use</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 4rem 2rem; font-size: var(--t-sm); }
  .top { display: grid; grid-template-columns: 1.3fr repeat(4, 1fr); gap: 2.5rem; }
  .id { display: grid; gap: 1rem; align-content: start; }
  .id img { height: 24px; width: auto; }
  address { font-style: normal; color: var(--muted); }
  h2 { font-size: var(--t-sm); font-weight: 600; color: var(--muted); letter-spacing: 0; margin-bottom: 0.9rem; }
  ul { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  a { color: var(--star); text-decoration: none; }
  a:hover { color: var(--cyan); text-decoration: underline; }
  .legal { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); }
  .legal p { margin-right: auto; }
  .legal a { color: var(--muted); }
  @media (max-width: 960px) { .top { grid-template-columns: 1fr 1fr; } .id { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .top { grid-template-columns: 1fr; } }
</style>
