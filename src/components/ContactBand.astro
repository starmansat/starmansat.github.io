---
import { company } from '../data/site';
interface Props { heading?: string; text?: string }
const {
  heading = 'Tell us about your mission',
  text = 'Whether you are a year from launch or running a fleet, a 30-minute call is enough to see if we can help.',
} = Astro.props;
---
<section class="band">
  <div class="wrap inner">
    <div>
      <h2>{heading}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="actions">
      <a class="btn" href="/contact/">Talk to us</a>
      <a class="btn btn--ghost" href={`mailto:${company.email}`}>{company.email}</a>
    </div>
  </div>
</section>

<style>
  .band { background: var(--deep); border-top: 1px solid var(--line); padding-block: clamp(3.5rem, 8vw, 5.5rem); }
  .inner { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; }
  h2 { font-size: var(--t-2xl); margin-bottom: 0.75rem; }
  .actions { margin-top: 0; }
  @media (max-width: 800px) { .inner { grid-template-columns: 1fr; } }
</style>
